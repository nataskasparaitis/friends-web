<div class="card">
  <h2 class="card-header">Sign up</h2>
  <div class="card-body">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="field form-group">
        <p><%# f.label :email %></p>
        <p><%= f.email_field :email, autofocus: true, autocomplete: "email", class:"form-control", placeholder:"Email" %></p>
      </div>

      <% hint = @minimum_password_length ? " (#{@minimum_password_length} characters minimum)" : ""%>
      <div class="field form-group">
        <p><%# f.label :password %></p>
        <p><%= f.password_field :password, autocomplete: "new-password", class:"form-control", placeholder:"Password#{hint}" %></p>
      </div>

      <div class="field form-group">
        <p><%# f.label :password_confirmation %></p>
        <p><%= f.password_field :password_confirmation, autocomplete: "new-password", class:"form-control", placeholder:"Confirm password" %></p>
      </div>

      <div class="actions">
        <%= f.submit "Sign up", class:"btn btn-success" %>
      </div>
    <% end %>
  </div>
</div>

</br>
<%= render "devise/shared/links" %>
