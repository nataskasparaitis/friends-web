<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
  	<%= link_to 'Friend App', home_index_path, class:"navbar-brand"%>
    <%#a class="navbar-brand" href="#">Friend App</a%>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarSupportedContent">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">

        <li class="nav-item">
          <%#a class="nav-link" href="#">Link</a%>
          <%= link_to 'About', home_about_path, class:"nav-link"%>  <%# we dont need to hard-code the path to home/about, rails knows it because of the file names (if you type 'rails routes' you can see it')%>
        </li>

        <% if user_signed_in? %>

          <li class="nav-item">
            <%= link_to 'Friends', friends_path, class:"nav-link"%>
          </li>
        
          <li class="nav-item">
            <%= link_to 'Add Friend', new_friend_path, class:"nav-link"%>
          </li>

          <li class="nav-item">
            <%#a class="nav-link" href="#">Link</a%>
            <%= link_to 'Sign Out', destroy_user_session_path, data: {turbo_method: :delete}, class:"nav-link"%>  <%# we dont need to hard-code the path to home/about, rails knows it because of the file names (if you type 'rails routes' you can see it')%>
          </li>

          <li class="nav-item">
            <%#a class="nav-link" href="#">Link</a%>
            <%= link_to 'Edit Profile',  edit_user_registration_path, class:"nav-link"%>  <%# we dont need to hard-code the path to home/about, rails knows it because of the file names (if you type 'rails routes' you can see it')%>
          </li>
        <% else %>

          <li class="nav-item">
            <%#a class="nav-link" href="#">Link</a%>
            <%= link_to 'Sign Up', new_user_registration_path, class:"nav-link"%>  <%# we dont need to hard-code the path to home/about, rails knows it because of the file names (if you type 'rails routes' you can see it')%>
          </li>

          <li class="nav-item">
            <%#a class="nav-link" href="#">Link</a%>
            <%= link_to 'Sign In',  new_user_session_path, class:"nav-link"%>  <%# we dont need to hard-code the path to home/about, rails knows it because of the file names (if you type 'rails routes' you can see it')%>
          </li>
        <% end %>

        
      </ul>
      <% if user_signed_in? %>
        <%# searches your own friends only, because FriendsController#index scopes to current_user %>
        <%= form_with url: friends_path, method: :get, class: "d-flex", role: "search" do |form| %>
          <%= form.search_field :q, value: params[:q], placeholder: "Search friends", class: "form-control me-2", "aria-label": "Search friends" %>
          <%= form.submit "Search", class: "btn btn-outline-success" %>
        <% end %>
      <% end %>
