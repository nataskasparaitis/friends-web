<% content_for :title, "Friends" %>

<h1>Friend List</h1>

<% if @query.present? %>
  <p class="text-muted">
    <%= pluralize(@friends.size, "result") %> for &ldquo;<%= @query %>&rdquo;.
    <%= link_to "Clear search", friends_path %>
  </p>
<% end %>

<% if @friends.any? %>
  <table class="table table-striped table-bordered table-hover">
    <thead class="table-dark">
      <tr>
        <th scope="col">Name</th>
        <th scope="col">Email</th>
        <th scope="col">Phone</th>
        <th scope="col">Twitter</th>
        <th colspan="2">Actions</th>
      </tr>
    </thead>
    <tbody id="friends">
      <% @friends.each do |friend| %>
        <tr>
          <td><%= link_to friend.full_name, friend %></td>
          <td><%= friend.email %></td>
          <td><%= friend.phone %></td>
          <td><%= friend.twitter %></td>
          <td><%= link_to "Edit", edit_friend_path(friend) %></td>
          <td><%= button_to "Delete", friend, method: :delete, data: {turbo_confirm: "Are you sure?"}, class:"btn btn-outline-danger" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% elsif @query.present? %>
  <p>No friends match that search.</p>
<% else %>
  <p>No friends yet. Add your first one below.</p>
<% end %>

<%= link_to "New friend", new_friend_path, class:"btn btn-secondary" %>
